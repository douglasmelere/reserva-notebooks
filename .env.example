# ---------------------------------------------------------------------------
# Copie para .env e ajuste. NUNCA versione o .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Banco de dados --------------------------------------------------------
# Desenvolvimento (docker compose up -d db):
DATABASE_URL="postgresql://reserva:devpass@localhost:55432/reserva_dev?schema=public"
# Produção no Coolify: use o hostname INTERNO do serviço PostgreSQL, nunca o IP
# público da VPS. O banco não deve ficar exposto na internet.
# DATABASE_URL="postgresql://reserva:SENHA@reserva-db:5432/reserva?schema=public"

# Banco temporário usado pelo `prisma migrate dev` para validar migrações.
# Opcional; se ausente, o Prisma cria e descarta um banco sozinho.
# SHADOW_DATABASE_URL="postgresql://reserva:devpass@localhost:55432/reserva_shadow"

# --- Aplicação -------------------------------------------------------------
NODE_ENV="development"

# URL pública. Usada para validar a origem das requisições (proteção CSRF) e
# para decidir se o cookie de sessão vai com a flag `secure`.
APP_URL="http://localhost:3000"

# Porta em que o servidor escuta. O Coolify injeta esta variável; localmente,
# 3000 é o padrão. O processo sempre escuta em 0.0.0.0.
PORT="3000"

# OBRIGATÓRIO. Segredo usado para derivar o hash dos tokens de sessão.
# Gere o seu com:  openssl rand -hex 32
# A aplicação se recusa a subir em produção com um valor de exemplo.
SESSION_SECRET="troque-este-valor-por-um-segredo-de-64-caracteres-hex-aleatorio"

# Duração da sessão, em horas. 12 cobre um turno escolar inteiro.
SESSION_TTL_HOURS="12"

# Fuso da instituição. Toda data/hora informada é interpretada neste fuso.
INSTITUTION_TIMEZONE="America/Sao_Paulo"

# Cookie `secure`: "auto" decide pelo APP_URL (https => true).
# Use "false" apenas em ambiente interno sem HTTPS.
COOKIE_SECURE="auto"

# --- Primeiro supervisor (bootstrap) ---------------------------------------
# Usados uma única vez por `npm run bootstrap:admin`. Remova depois de criar a
# conta. Senha com no mínimo 12 caracteres.
# BOOTSTRAP_ADMIN_USERNAME="supervisao"
# BOOTSTRAP_ADMIN_PASSWORD=""
# BOOTSTRAP_ADMIN_NAME="Supervisão de TI"

# --- Armazenamento de anexos das ocorrências -------------------------------
# "local" grava em volume; "s3" grava em serviço compatível com S3 (recomendado
# em produção, porque não amarra os arquivos ao ciclo de vida do container).
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="/data/uploads"

# S3 / MinIO / Backblaze B2 / Cloudflare R2 / Hostinger Object Storage
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# S3_REGION="us-east-1"
# S3_BUCKET="reserva-notebooks"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"   # "true" para MinIO e compatíveis

# --- Segurança -------------------------------------------------------------
# Custo do Argon2id. Os padrões seguem a recomendação da OWASP.
# Aumente ARGON2_MEMORY_COST se a VPS tiver folga de memória.
ARGON2_MEMORY_COST="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"

# Rate limiting do login.
LOGIN_MAX_ATTEMPTS="8"
LOGIN_WINDOW_MINUTES="15"

# --- Container -------------------------------------------------------------
# Aplicar migrações automaticamente ao iniciar. Deixe "false" se você preferir
# rodar `npx prisma migrate deploy` manualmente antes de publicar.
RUN_MIGRATIONS="true"
# Rodar o seed de desenvolvimento na inicialização. NUNCA "true" em produção.
RUN_SEED="false"
